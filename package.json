{
  "name": "spherex",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:cultures": "node scripts/ingest-sky-cultures.mjs",
    "import:stars": "node --env-file-if-exists=.env scripts/import-star-profiles.mjs",
    "cache:culture-anchors": "node scripts/cache-sky-anchors.mjs",
    "update:index": "node scripts/update-observation-index.mjs",
    "refresh:cache": "node scripts/refresh-search-cache.mjs",
    "bake:tour": "node scripts/bake-tour-view.mjs",
    "bake:recovery": "node scripts/bake-recovery-pairs.mjs",
    "recovery:grid": "node scripts/recovery-grid.mjs",
    "build": "node scripts/build-vercel.mjs",
    "dev": "node --env-file-if-exists=.env frontend/server.mjs",
    "start": "node frontend/server.mjs",
    "test": "node --test frontend/coordinates.test.js frontend/tests/*.test.js"
  }
}
