{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/observations.js": {
      "maxDuration": 120,
      "includeFiles": "data/**"
    },
    "api/observation-quality.js": {
      "maxDuration": 30
    },
    "api/pixel-quality.js": {
      "maxDuration": 10
    },
    "api/cutout.js": {
      "maxDuration": 120
    },
    "api/crop.js": {
      "maxDuration": 30,
      "regions": ["iad1"]
    },
    "api/index-status.js": {
      "maxDuration": 10,
      "includeFiles": "data/**"
    },
    "api/agent.js": {
      "maxDuration": 30
    },
    "api/resolve-object.js": {
      "maxDuration": 15
    },
    "api/star-details.js": {
      "maxDuration": 10
    }
  }
}
