{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node --check frontend/server.mjs"
  },
  "deploy": {
    "startCommand": "HOST=0.0.0.0 NODE_OPTIONS=--max-old-space-size=192 npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
